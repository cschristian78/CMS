    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>http://cms-dev/</SiteUrlToLaunchAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <ProjectGuid>6a6a6bf2-f395-b3da-8a6a-fb46c07cd37f</ProjectGuid>
    <SelfContained>false</SelfContained>
    <MSDeployServiceURL>vm-usc-dev-03</MSDeployServiceURL>
    <DeployIisAppPath>CMS-Dev</DeployIisAppPath>
    <RemoteSitePhysicalPath />
    <SkipExtraFilesOnServer>true</SkipExtraFilesOnServer>
    <MSDeployPublishMethod>InProc</MSDeployPublishMethod>
