<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Request size limits must sit outside location so IIS RequestFilteringModule applies them. -->
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- ~2.1 GB - covers multipart overhead above the app 2 GB file cap -->
        <requestLimits maxAllowedContentLength="2254857830" />
      </requestFiltering>
    </security>
  </system.webServer>
  <!-- Do not compress SignalR. IIS buffering breaks Server-Sent Events until WebSockets are enabled. -->
  <location path="hubs">
    <system.webServer>
      <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    </system.webServer>
  </location>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- Allow hosting under sites that inherit classic system.web settings (e.g. inetpub\wwwroot). -->
      <validation validateIntegratedModeConfiguration="false" />
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\ClientManagementSystem.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
