<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Request size limits must sit outside location so IIS RequestFilteringModule applies them. -->
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- 200 MB - covers multipart overhead above the app 50 MB file cap -->
        <requestLimits maxAllowedContentLength="209715200" />
      </requestFiltering>
    </security>
  </system.webServer>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- Allow hosting under sites that inherit classic system.web settings (e.g. inetpub\wwwroot). -->
      <validation validateIntegratedModeConfiguration="false" />
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\ClientManagementSystem.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
